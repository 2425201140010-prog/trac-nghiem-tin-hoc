<script>
function submitQuiz(){
 let correct=0, answered=0;
 document.querySelectorAll('.q').forEach(q=>{
   const c=q.dataset.correct, chosen=q.querySelector('input:checked');
   q.querySelectorAll('.opt').forEach(x=>x.classList.remove('right','wrong'));
   const fb=q.querySelector('.feedback');
   if(!chosen){fb.textContent='⚠️ Chưa chọn đáp án'; return;}
   answered++;
   if(c && chosen.value===c){correct++; chosen.closest('.opt').classList.add('right'); fb.textContent='✅ Đúng';}
   else if(c){chosen.closest('.opt').classList.add('wrong'); fb.textContent='❌ Sai — đáp án đúng: '+c;}
   else{fb.textContent='ℹ️ Câu này chưa có đáp án chuẩn trong dữ liệu nguồn.';}
 });
 const total=document.querySelectorAll('.q').length;
 const known=document.querySelectorAll('.q[data-correct]').length;
 document.getElementById('score').textContent='Điểm: '+correct+'/'+known+' câu có đáp án chuẩn | Đã làm: '+answered+'/'+total;
 window.scrollTo({top:0,behavior:'smooth'});
}
</script></body></html>