<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Trắc nghiệm Tin học - Phần 7</title>
<style>
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial;max-width:850px;margin:auto;padding:16px;background:#f4f6fa}
h1{font-size:24px} .bar{position:sticky;top:0;background:white;padding:12px;border-radius:10px;box-shadow:0 2px 8px #ddd;z-index:2}
.q{background:#fff;margin:14px 0;padding:16px;border-radius:12px;box-shadow:0 1px 5px #ddd}
.qt{font-weight:600;line-height:1.45;margin-bottom:10px}
.opt{display:flex;gap:8px;padding:10px;border:1px solid #ddd;border-radius:9px;margin:7px 0;cursor:pointer}
.opt:hover{background:#f3f6ff} .right{border:2px solid #2e9d50;background:#effbf2} .wrong{border:2px solid #d33;background:#fff0f0}
.feedback{margin-top:8px;font-weight:600}
button{background:#111;color:#fff;border:0;border-radius:9px;padding:12px 18px;font-size:16px}
